# Copy this file to .env and fill in the key for whichever provider you use.
# Model routing is controlled by CREW_MODEL ("provider/model", matching one of
# CrewAI's native providers or its openai_compatible group - see README).

# Default provider: Anthropic
ANTHROPIC_API_KEY=
CREW_MODEL=anthropic/claude-sonnet-5

# To use OpenAI instead:
# OPENAI_API_KEY=
# CREW_MODEL=openai/gpt-4o

# To use a local Ollama model instead (no API key needed):
# 1. Install Ollama (https://ollama.com) and start the server: ollama serve
# 2. Pull a model that supports tool/function calling, e.g.: ollama pull llama3.1
# 3. Sanity-check it can actually call tools before running the full crew:
#      python check_llm_connection.py
# CREW_MODEL=ollama/llama3.1
# OLLAMA_HOST=http://localhost:11434   # only needed if the server isn't at the default address

# To use Google Gemini instead (free API key, no payment method required):
# 1. Get a free key at https://aistudio.google.com/apikey
# 2. pip install "crewai[google-genai]"
# GOOGLE_API_KEY=
# CREW_MODEL=gemini/gemini-2.0-flash

# --- Chat frontend (chat_app/) ---
# A second, separate frontend (chainlit run chat_app/app.py) alongside the
# Streamlit/CLI pipeline above. Reuses CREW_MODEL/the provider key above to
# translate a trader's plain-language strategy into the safe expression DSL
# (pair_crew/tools/dsl_tools.py); the actual backtest is always the same
# deterministic engine used everywhere else in this repo.

# Random secret chainlit uses to sign session cookies/JWTs. Generate one with:
#   chainlit create-secret
CHAINLIT_AUTH_SECRET=

# Trader roster: "username:bcrypt_hash,username2:bcrypt_hash2,...". Generate
# each hash with `python chat_app/hash_password.py` (plaintext passwords are
# never stored). Each trader's strategies/results are private to them,
# isolated under chat_app/user_data/<username>/.
CHAT_TRADERS=
